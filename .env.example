# ─────────────────────────────────────────────────────────────
# YouTube Watch-Time Accelerator — environment configuration
# Copy this file to `.env.local` (dev) or `.env` and fill in values.
# The app runs fully in DEMO mode with NONE of these set.
# ─────────────────────────────────────────────────────────────

# ---- App ----
NODE_ENV=development
# Public base URL of the app (used for OAuth callbacks / OG)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---- Database (optional in demo mode) ----
# When set, analytics/ideas/experiments can be persisted via Prisma.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ytwta?schema=public

# ---- AI provider (NOVA strategist) ----
# provider: gemini | openai | anthropic | none
# With no key set, NOVA falls back to a deterministic rule-based engine.
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# ---- YouTube Data API v3 (optional) ----
# oEmbed metadata in the Video Lab needs NO key. A Data API key unlocks
# richer public stats (views/likes/comments). Get one at:
# https://console.cloud.google.com/apis/credentials
YOUTUBE_API_KEY=

# ---- YouTube OAuth (optional — for pulling YOUR OWN private analytics) ----
# Enables the real (non-demo) monetization + retention data for your channel.
# Requires OAuth consent screen + these scopes:
#   https://www.googleapis.com/auth/youtube.readonly
#   https://www.googleapis.com/auth/yt-analytics.readonly
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/auth/youtube/callback

# ---- Session secret (used if you enable OAuth) ----
AUTH_SECRET=change-me-to-a-long-random-string
